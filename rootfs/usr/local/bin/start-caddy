#!/bin/bash
# Password-protected front door: KasmVNC behind basic auth, HTTPS when a domain is set.
set -euo pipefail

SYS=/var/lib/workspace-system
WORKSPACE_AUTH_HASH=$(cat "$SYS/auth.hash")
export WORKSPACE_AUTH_HASH
export XDG_DATA_HOME="$SYS/caddy" XDG_CONFIG_HOME="$SYS/caddy-config"

if [ -n "${WORKSPACE_DOMAIN:-}" ]; then
    export WORKSPACE_SITE="$WORKSPACE_DOMAIN"
else
    export WORKSPACE_SITE=":8080"
fi

if [ "${1:-}" = "--validate-only" ]; then
    exec caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
fi
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
