#!/bin/bash
# Container entrypoint (runs as root): prepare user, volumes and runtime
# state, then hand over to supervisord.
set -euo pipefail

# Root must never run binaries from user-writable dirs. Keep the user PATH
# (from the image ENV) for the user's own programs under supervisord.
export WORKSPACE_USER_PATH="$PATH"
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

PUID=${PUID:-1000}
PGID=${PGID:-1000}

log() { echo "[workspace-init] $*"; }

# --- user / group ids -------------------------------------------------------
if [ "$(id -g workspace)" != "$PGID" ]; then
    groupmod -o -g "$PGID" workspace
fi
if [ "$(id -u workspace)" != "$PUID" ]; then
    usermod -o -u "$PUID" workspace
fi
if [ "$(stat -c %u /workspace)" != "$PUID" ] || [ "$(stat -c %g /workspace)" != "$PGID" ]; then
    log "fixing ownership of /workspace for $PUID:$PGID"
    chown -R "$PUID:$PGID" /workspace
fi

# --- first start: seed the home folder (never overwrite later) --------------
if [ ! -e /workspace/.workspace-seeded ]; then
    log "seeding /workspace"
    cp -an /etc/workspace/skel/. /workspace/
    chown -R "$PUID:$PGID" /workspace
    touch /workspace/.workspace-seeded
fi

# --- Flathub as a per-user remote (installs land in /workspace) -------------
runuser -u workspace -- flatpak remote-add --user --if-not-exists flathub /etc/workspace/flathub.flatpakrepo \
    || log "warning: could not add the flathub remote"

# --- cache volume: re-downloadable data lives outside /workspace -----------
CACHE=/var/cache/workspace
if [ "$(stat -c %u "$CACHE")" != "$PUID" ]; then
    chown -R "$PUID:$PGID" "$CACHE" || log "warning: could not chown $CACHE"
fi
while read -r rel; do
    case $rel in ''|'#'*) continue ;; esac
    src=/workspace/$rel
    dst=$CACHE/${rel#.}
    [ "$(readlink "$src" 2>/dev/null)" = "$dst" ] && { runuser -u workspace -- mkdir -p "$dst"; continue; }
    [ -L "$src" ] && continue                      # the user linked it elsewhere
    [ -e "$src" ] && [ ! -d "$src" ] && continue   # a file, not ours to touch
    runuser -u workspace -- mkdir -p "$dst" "$(dirname "$src")" || continue
    if [ -d "$src" ]; then
        runuser -u workspace -- cp -a "$src/." "$dst/" && runuser -u workspace -- rm -rf "$src" \
            || { log "warning: could not move $src to the cache volume"; continue; }
    fi
    runuser -u workspace -- ln -s "$dst" "$src" || log "warning: could not link $src"
done < /etc/workspace/cache-paths

# --- Codex: seed a config once (never touch an existing one) ----------------
if [ ! -e /workspace/.codex/config.toml ]; then
    runuser -u workspace -- mkdir -p /workspace/.codex
    runuser -u workspace -- cp /etc/workspace/codex-config.toml /workspace/.codex/config.toml \
        || log "warning: could not seed ~/.codex/config.toml"
fi

# --- agent skills: link the image's skills into each agent's skill dir ------
# Links follow image updates; a real directory the user put there is kept.
for dir in .claude/skills .codex/skills .agents/skills .gemini/skills; do
    runuser -u workspace -- mkdir -p "/workspace/$dir"
    for skill in /opt/workspace/skills/*/; do
        skill=${skill%/}
        link="/workspace/$dir/$(basename "$skill")"
        if [ -L "$link" ] || [ ! -e "$link" ]; then
            runuser -u workspace -- ln -sfn "$skill" "$link"
        fi
    done
done

# --- runtime dir (fixed path so `docker exec` sees the same env) ------------
rm -rf "$XDG_RUNTIME_DIR"
install -d -m 700 -o "$PUID" -g "$PGID" "$XDG_RUNTIME_DIR"

# --- system bus ------------------------------------------------------------------
install -d -m 755 /run/dbus
rm -f /run/dbus/system_bus_socket
dbus-uuidgen --ensure

# --- leftovers from an unclean stop ------------------------------------------
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
# Chromium locks its profile to a hostname; a recreated container has a new one.
rm -f /workspace/.config/chromium-shared/Singleton{Lock,Socket,Cookie}

# --- web password ------------------------------------------------------------
SYS=/var/lib/workspace-system
chown caddy:caddy "$SYS" && chmod 700 "$SYS"
if [ -n "${WORKSPACE_PASSWORD:-}" ]; then
    caddy hash-password --plaintext "$WORKSPACE_PASSWORD" > "$SYS/auth.hash"
elif [ ! -s "$SYS/auth.hash" ]; then
    generated=$(head -c 18 /dev/urandom | base64 | tr '+/' '-_')
    caddy hash-password --plaintext "$generated" > "$SYS/auth.hash"
    echo "WORKSPACE PASSWORD (generated): $generated"
fi
chown caddy:caddy "$SYS/auth.hash" && chmod 600 "$SYS/auth.hash"
[ -d "$SYS/caddy" ] && chown -R caddy:caddy "$SYS"/caddy*
unset WORKSPACE_PASSWORD

# --- sudo ----------------------------------------------------------------------
# With Flatpak support (systempaths=unconfined) root here can write host kernel
# settings, i.e. root in this container is root on the host. Only give the
# user sudo when that isn't the case, or when explicitly asked to.
case "${WORKSPACE_SUDO:-auto}" in
    1|true|yes) sudo_on=1 ;;
    0|false|no) sudo_on=0 ;;
    *) if [ -w /proc/sys/kernel/core_pattern ]; then sudo_on=0; else sudo_on=1; fi ;;
esac
if [ "$sudo_on" = 1 ]; then
    echo "workspace ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/workspace
    chmod 440 /etc/sudoers.d/workspace
else
    rm -f /etc/sudoers.d/workspace
    log "sudo disabled (set WORKSPACE_SUDO=1 to enable; see README)"
fi

exec /usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf
