# Copy to .env and adjust. All values are optional.

# Image: built locally from this repo by default. To use the published one:
#   WORKSPACE_IMAGE=ghcr.io/zefhemel/container-computer:latest
#   WORKSPACE_PULL_POLICY=always
WORKSPACE_IMAGE=container-computer:latest
WORKSPACE_PULL_POLICY=build

# Which compose files to use. Default: Flatpak support on.
#   Flatpak off:      COMPOSE_FILE=compose.yaml:compose.no-flatpak.yaml
#   Public HTTPS:     COMPOSE_FILE=compose.yaml:compose.domain.yaml
COMPOSE_FILE=compose.yaml

# Web desktop login (user name: workspace). Empty: a password is generated
# on first start and printed once in `docker compose logs`.
# Keep the single quotes: without them Compose expands `$` in the value.
WORKSPACE_PASSWORD=''

# Public domain for automatic HTTPS. Needs compose.domain.yaml (ports 80/443);
# with a domain set, the web port above is no longer served.
WORKSPACE_DOMAIN=

# Where the web desktop listens on the host. 0.0.0.0 to expose it.
WORKSPACE_WEB_BIND=127.0.0.1
WORKSPACE_WEB_PORT=8080

# Agent ports (always bound to host localhost). Change per instance.
WORKSPACE_VNC_PORT=5901
WORKSPACE_CDP_PORT=9222

# Passwordless sudo for the workspace user: auto (default) enables it only
# when Flatpak support is off. With Flatpak support on, root in the container
# can change host kernel settings, so 1 effectively gives the agent root on
# the Docker host. 0 always disables it.
WORKSPACE_SUDO=auto

# The home folder (/workspace): a folder on this machine, relative to this
# directory. Everything you and the agent install or save lives here.
WORKSPACE_HOME_DIR=./workspace

# Owner of files in /workspace. On Linux, set these to your own `id -u` /
# `id -g` so the folder stays yours. (Docker Desktop and OrbStack on macOS
# map ownership to your user automatically.)
PUID=1000
PGID=1000

# Desktop size at start; a browser window connecting resizes it to fit.
WORKSPACE_RESOLUTION=1280x800
