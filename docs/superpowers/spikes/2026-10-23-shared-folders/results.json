          "expected_exit": null,
          "matches": true
        },
        {
          "check": "owner writes with mode 0700",
          "exit": 0,
          "stdout": "",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "other UID denied by mode 0700",
          "exit": 0,
          "stdout": "owned",
          "stderr": "",
          "expected_exit": 1,
          "matches": false
        }
      ]
    },
