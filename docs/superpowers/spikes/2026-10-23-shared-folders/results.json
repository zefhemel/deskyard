          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "grant persists after client restart",
          "exit": 0,
          "stdout": "original\nappended",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "grant persists after client recreation",
          "exit": 0,
          "stdout": "original\nappended",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
