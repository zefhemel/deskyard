          "expected_exit": 1,
          "matches": true
        },
        {
          "check": "outsider cannot read",
          "exit": 1,
          "stdout": "",
          "stderr": "cat: /shared/project/ordinary: Permission denied",
          "expected_exit": 1,
          "matches": true
        },
        {
          "check": "unprivileged client cannot switch identity",
          "exit": 127,
          "stdout": "",
          "stderr": "setpriv: setresuid failed: Operation not permitted",
          "expected_exit": 127,
          "matches": true
        },
        {
          "check": "client cannot change root-owned gate",
          "exit": 1,
          "stdout": "",
          "stderr": "chmod: changing permissions of '/shared/project': Operation not permitted",
          "expected_exit": 1,
          "matches": true
        },
        {
          "check": "live grant write",
          "exit": 0,
          "stdout": "",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "downgraded reader cannot modify writer file",
          "exit": 2,
          "stdout": "",
          "stderr": "sh: 1: cannot create /shared/project/ordinary: Permission denied",
          "expected_exit": 2,
          "matches": true
        },
        {
          "check": "downgraded reader STILL writes own file",
          "exit": 0,
          "stdout": "",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "owner can override file sharing ACL",
          "exit": 0,
          "stdout": "",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "reader loses access after owner chmod",
          "exit": 1,
          "stdout": "",
          "stderr": "cat: /shared/project/ordinary: Permission denied",
          "expected_exit": 1,
          "matches": true
        },
        {
          "check": "application creates private-mode file",
          "exit": 0,
          "stdout": "",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "default ACL cannot override mode 0600",
          "exit": 1,
          "stdout": "",
          "stderr": "cat: /shared/project/private: Permission denied",
          "expected_exit": 1,
          "matches": true
        },
        {
          "check": "revocation: absolute denied, retained directory/file FDs usable",
          "exit": 0,
          "stdout": "absolute:denied:13\ndirfd:allowed:original\nappended\nopenfd:allowed:original\nappended",
          "stderr": "",
          "expected_exit": 0,
          "matches": true
        },
        {
          "check": "file ACL revocation cannot revoke open FD",
