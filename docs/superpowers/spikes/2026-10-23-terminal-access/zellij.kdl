// Prototype defaults; user's normal shell and Zellij config remain untouched.
show_startup_tips false
show_release_notes false
// Headless clients have no default user layout directory. Set it explicitly.
layout_dir "/etc/deskyard"
default_layout "terminal-layout"
scroll_buffer_size 20000
session_serialization false
web_server_ip "127.0.0.1"
web_server_port 8083
// Browser shortcuts pass through until Ctrl-g unlocks the workspace controls.
default_mode "locked"
// Sessions created through the CLI explicitly opt into the authenticated web server.
web_sharing "on"
default_shell "/bin/bash"

// Expose terminal controls, without the engine's branded plugin menus.
keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    normal {
        bind "Ctrl g" "Esc" { SwitchToMode "Locked"; }
        bind "Ctrl o" { SwitchToMode "Session"; }
        bind "Ctrl p" { SwitchToMode "Pane"; }
        bind "Ctrl t" { SwitchToMode "Tab"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }
    session {
        bind "d" { Detach; }
        bind "Esc" "Ctrl g" { SwitchToMode "Locked"; }
    }
    pane {
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "Left" { MoveFocus "Left"; }
        bind "Right" { MoveFocus "Right"; }
        bind "Up" { MoveFocus "Up"; }
        bind "Down" { MoveFocus "Down"; }
        bind "Esc" "Ctrl g" { SwitchToMode "Locked"; }
    }
    tab {
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "Left" { GoToPreviousTab; }
        bind "Right" { GoToNextTab; }
        bind "Esc" "Ctrl g" { SwitchToMode "Locked"; }
    }
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Esc" "Ctrl g" { ScrollToBottom; SwitchToMode "Locked"; }
    }
}
