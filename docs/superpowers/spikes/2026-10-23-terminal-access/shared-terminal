#!/bin/bash
# Shared by the CLI, XFCE launcher and web client. Deliberately opt-in.
set -euo pipefail
background=false
if [ "${1:-}" = --background ]; then
    background=true
    shift
fi
session=${1:-main}
if [ "$#" -gt 1 ] || [[ ! "$session" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$ ]]; then
    echo 'Usage: shared-terminal [--background] [SESSION] (letters, digits, - or _)' >&2
    exit 2
fi
export TERM=${TERM:-xterm-256color}
if "$background"; then
    # --create-background refuses an existing session rather than attaching.
    if zellij list-sessions --short --no-formatting 2>/dev/null | grep -Fxq -- "$session"; then
        exit 0
    fi
    exec zellij --config /etc/deskyard/zellij-prototype.kdl --layout /etc/deskyard/terminal-layout.kdl attach --create-background "$session"
fi
/usr/local/bin/shared-terminal --background "$session"
exec /usr/local/bin/terminal-attach --config /etc/deskyard/zellij-prototype.kdl attach "$session"
