{
    admin off
    auto_https off
}

http://127.0.0.1:8082 {
    bind 127.0.0.1
    root * /opt/deskyard/terminal-web
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ws: wss:; img-src 'self' data:"
    }
    route {
        # Enter the shared workspace directly; skip the engine welcome plugin.
        redir / /main 302
        @presentation path /assets/app.js /assets/manifest.webmanifest /assets/deskyard.svg /assets/icon-192.png /assets/icon-512.png
        handle @presentation {
            header Cache-Control no-store
            file_server
        }
        # Old bookmarked icon URLs must not keep showing the upstream icon.
        @old_icon path /favicon.ico /assets/favicon.ico
        redir @old_icon /assets/deskyard.svg
        @page {
            method GET
            not path /assets/* /command/* /info/* /ws/* /session-list /session
        }
        handle @page {
            header Cache-Control no-store
            rewrite * /index.html
            file_server
        }
        # Authentication, cookies, control messages and both WebSockets pass through.
        reverse_proxy 127.0.0.1:8083
    }
}
