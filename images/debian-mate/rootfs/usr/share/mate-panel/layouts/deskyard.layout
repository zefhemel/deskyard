[Toplevel bottom]
expand=true
orientation=bottom
size=40

[Object menu-bar]
object-type=menu
toplevel-id=bottom
position=0
use-custom-icon=true
custom-icon=start-here
tooltip=Applications
locked=true

[Object files]
object-type=launcher
toplevel-id=bottom
position=44
launcher-location=/usr/share/applications/caja-browser.desktop
locked=true

[Object browser]
object-type=launcher
toplevel-id=bottom
position=86
launcher-location=/usr/local/share/applications/chromium.desktop
locked=true

[Object software]
object-type=launcher
toplevel-id=bottom
position=128
launcher-location=/usr/share/applications/org.gnome.Software.desktop
locked=true

[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
position=180
locked=true

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=bottom
position=150
relative-to-edge=end
locked=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=bottom
position=0
relative-to-edge=end
locked=true
