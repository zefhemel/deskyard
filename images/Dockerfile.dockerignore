# The build context is the repository root (the image also builds the
# desktop command from supervisor/); only send what the image needs.
*
!images/*/rootfs
!images/common/patches
!images/common/finalize.sh
!images/common/build-flatpak.sh
!images/common/build-mate-desktop.sh
!images/tests/native/flatpak-openat2.c
!supervisor
supervisor/web/node_modules
supervisor/internal/web/dist

# Python UI/integration artifacts and build outputs are not CLI sources.
supervisor/tests
supervisor/bin
supervisor/dist
supervisor/web
