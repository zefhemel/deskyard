#!/bin/bash
# The shared Chromium: one profile for human and agent. Started on demand
# (cdp-connect, the `chromium` command), not with the desktop. Its CDP port 9220 is
# internal; agents use 9221 through cdp-connect.
# The profile must not be Chromium's default dir: Chromium ignores
# --remote-debugging-port there.
PROFILE=/workspace/.config/chromium-shared

for _ in $(seq 100); do
    [ -S /tmp/.X11-unix/X1 ] && break
    sleep 0.1
done
# Wait until the top panel has reserved its space (the work area no longer
# starts at y=0): maximizing earlier puts the title bar under the panel.
for _ in $(seq 200); do
    xprop -root _NET_WORKAREA 2>/dev/null | grep -Eq '= *[0-9]+, *[1-9]' && break
    sleep 0.1
done

flags=(
    --user-data-dir="$PROFILE"
    --remote-debugging-port=9220
    --no-first-run
    --no-default-browser-check
    --password-store=basic
    --start-maximized
)
# Chromium's sandbox needs user namespaces, which Docker's default seccomp
# profile blocks (they are allowed in Flatpak mode).
if ! unshare -Ur true 2>/dev/null; then
    flags+=(--no-sandbox --test-type)
fi

# While Chromium is open the marker exists, so the next start of the desktop
# (start-session) brings it back. A person closing it (exit 0) removes the
# marker; a crash or the container stopping keeps it.
MARKER="$PROFILE/.open"
mkdir -p "$PROFILE" && touch "$MARKER"
/usr/bin/chromium "${flags[@]}" "$@"
status=$?
# (A second start only hands its URL to the running browser and exits 0.)
# (The desktop stopping closes it too; start-session marks that.)
if [ "$status" = 0 ] && [ ! -e "$XDG_RUNTIME_DIR/stopping" ] \
    && ! pgrep -u "$(id -u)" -f -- "--user-data-dir=$PROFILE" >/dev/null; then
    rm -f "$MARKER"
fi
exit "$status"
