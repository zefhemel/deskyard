#!/bin/bash
# Selkies: streams display :1 and the Deskyard speaker over one WebSocket
# (/api/websockets) on 127.0.0.1:6080, behind Caddy and the supervisor's token,
# so its own basic auth is off. The supervisor serves Selkies' web client from
# the image and proxies only the stream and uploads.
set -euo pipefail

# The X server, at its starting size (start-xvfb).
for _ in $(seq 100); do
    [ -e "$XDG_RUNTIME_DIR/xvfb-ready" ] && break
    sleep 0.1
done

# The webcam needs a v4l2loopback device the user can write to; without one
# it stays off (and Selkies' page offers none).
webcam='false|locked' webcam_device=false
for dev in /dev/video*; do
    if [ -c "$dev" ] && [ -w "$dev" ] && [ -e "/sys/devices/virtual/video4linux/${dev#/dev/}" ]; then
        webcam=true webcam_device=$dev
        break
    fi
done

# The supervisor rewrites Host when proxying, so a browser's Origin never
# matches it: the supervisor checks the Origin itself and then sends this one.
export SELKIES_ALLOWED_ORIGINS=http://supervisor.deskyard.invalid

# What Deskyard doesn't offer is locked off: an unlocked setting is only the
# page's default, which a page may change.
export SELKIES_ENABLE_BASIC_AUTH=false \
    SELKIES_ENABLE_DUAL_MODE='false|locked' \
    SELKIES_WEB_ROOT=/opt/selkies/lib/python3.13/site-packages/selkies/selkies_web \
    SELKIES_AUDIO_DEVICE_NAME=deskyard-speaker.monitor \
    SELKIES_VIDEO_STREAMING_MODE=false \
    SELKIES_USE_CSS_SCALING='true|locked' \
    SELKIES_USE_BROWSER_CURSORS='false|locked' \
    SELKIES_KEYBOARD_SHORTCUTS='false|locked' \
    SELKIES_UI_SHOW_SIDEBAR=false \
    SELKIES_MICROPHONE_ENABLED=true \
    SELKIES_GAMEPAD_ENABLED=true \
    SELKIES_WEBCAM_ENABLED="$webcam" \
    SELKIES_WEBCAM_DEVICE="$webcam_device" \
    SELKIES_FILE_TRANSFERS=upload \
    SELKIES_FILE_MANAGER_PATH=/workspace/Desktop \
    SELKIES_PRINTING_ENABLED='false|locked' \
    SELKIES_ENABLE_SHARED='false|locked' \
    SELKIES_ENABLE_PLAYER2='false|locked' \
    SELKIES_ENABLE_PLAYER3='false|locked' \
    SELKIES_ENABLE_PLAYER4='false|locked' \
    SELKIES_UI_SIDEBAR_SHOW_SHARING=false
exec /opt/selkies/bin/selkies --mode websockets --addr 127.0.0.1 --port 6080
