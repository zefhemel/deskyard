#!/bin/bash
# One-time updates of panel settings saved by older images, so existing homes
# get the image's current layout (/etc/xdg/xfce4/panel/default.xml). Each runs
# once per home; later changes by the user stick.
markers="$HOME/.config/workspace"
saved="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"

panel() { xfconf-query -c xfce4-panel "$@" 2>/dev/null; }

# Debian's dock autohides behind any overlapping window, i.e. always behind
# the maximized Chromium.
dock_visible() {
    local behavior
    behavior=$(panel -p /panels/panel-2/autohide-behavior) || return
    [ "$behavior" != 1 ] || panel -p /panels/panel-2/autohide-behavior -s 0
}

# No user menu in the top panel. The small separator before it went too; the
# expanding one pushes the systray right.
trim_top_panel() {
    local ids id keep=()
    ids=$(panel -p /panels/panel-1/plugin-ids | grep -E '^[0-9]+$') || return
    for id in $ids; do
        if [ "$(panel -p "/plugins/plugin-$id")" = actions ]; then
            if [ ${#keep[@]} -gt 0 ]; then
                local prev=${keep[-1]}
                if [ "$(panel -p "/plugins/plugin-$prev")" = separator ] \
                    && [ "$(panel -p "/plugins/plugin-$prev/expand")" != true ]; then
                    unset 'keep[-1]'
                fi
            fi
            continue
        fi
        keep+=("$id")
    done
    set_top_panel "${keep[@]}"
}

set_top_panel() {
    local args=() id
    for id; do args+=(-t int -s "$id"); done
    panel -p /panels/panel-1/plugin-ids --force-array "${args[@]}"
}

# Lowest plugin id above every id in use.
next_plugin_id() {
    local max
    max=$(panel -l | sed -n 's|^/plugins/plugin-\([0-9][0-9]*\).*|\1|p' | sort -n | tail -1)
    echo $(( ${max:-0} + 1 ))
}

new_plugin() { # TYPE -> prints the new id
    local id
    id=$(next_plugin_id)
    panel -p "/plugins/plugin-$id" -n -t string -s "$1" || return
    echo "$id"
}

# Homes trimmed by an older image lost the clock. (The workspace switcher it
# also lost is left out of the taskbar now.)
restore_top_panel() {
    local ids id sep clock
    ids=$(panel -p /panels/panel-1/plugin-ids | grep -E '^[0-9]+$') || return
    for id in $ids; do
        [ "$(panel -p "/plugins/plugin-$id")" = clock ] && return 0
    done
    sep=$(new_plugin separator) || return
    clock=$(new_plugin clock) || return
    panel -p "/plugins/plugin-$clock/digital-layout" -n -t uint -s 3
    # shellcheck disable=SC2086
    set_top_panel $ids "$sep" "$clock"
}

ids_of() { panel -p "/panels/panel-$1/plugin-ids" | grep -E '^[0-9]+$'; }

# Older images had a top panel and a narrow centred dock (panel-2). Fold the
# dock's launchers into the top panel after the applications menu, with
# show-desktop last and no workspace switcher, and move that panel to the
# bottom as one taskbar. Only the
# image's own two-panel layout is changed; panels the user rearranged stay.
single_taskbar() {
    local panels top dock id kind menu=() launchers=() rest=() end=()
    panels=$(panel -p /panels | grep -E '^[0-9]+$' | tr '\n' ' ') || return
    [ "$panels" = "1 2 " ] || return 0
    [ "$(panel -p /panels/panel-2/position)" = "p=10;x=0;y=0" ] || return 0
    top=$(ids_of 1) || return
    dock=$(ids_of 2) || return
    for id in $top; do
        kind=$(panel -p "/plugins/plugin-$id")
        if [ "$kind" = applicationsmenu ] && [ ${#menu[@]} = 0 ]; then
            menu+=("$id")
        elif [ "$kind" = pager ]; then
            panel -p "/plugins/plugin-$id" -r -R
        else
            rest+=("$id")
        fi
    done
    for id in $dock; do
        kind=$(panel -p "/plugins/plugin-$id")
        case $kind in
            showdesktop) end+=("$id") ;;
            directorymenu) panel -p "/plugins/plugin-$id" -r -R ;;
            *) launchers+=("$id") ;;
        esac
    done
    # The dock's separator before its directory menu now divides the launchers
    # from the window list.
    set_top_panel "${menu[@]}" "${launchers[@]}" "${rest[@]}" "${end[@]}" || return
    # Plain gaps instead of dotted handles between groups.
    for id in "${launchers[@]}" "${rest[@]}"; do
        case $(panel -p "/plugins/plugin-$id") in
            separator) [ "$(panel -p "/plugins/plugin-$id/expand")" = true ] \
                || panel -p "/plugins/plugin-$id/style" -n -t uint -s 0 ;;
            tasklist) panel -p "/plugins/plugin-$id/show-handle" -n -t bool -s false ;;
        esac
    done
    panel -p /panels/panel-1/position -s "p=8;x=0;y=0" || return
    panel -p /panels/panel-1/size -s 40
    panel -p /panels/panel-1/icon-size -n -t uint -s 24
    panel -p /panels/panel-2 -r -R
    panel -p /panels --force-array -t int -s 1
}

# once MARKER STEP: run STEP unless done before. A home without saved panel
# settings starts from the current defaults, so it needs no step.
once() {
    [ -e "$markers/$1" ] && return
    if [ ! -e "$saved" ] || "$2"; then
        mkdir -p "$markers"
        touch "$markers/$1"
    fi
}

once migrated-dock-visible dock_visible
once migrated-top-panel trim_top_panel
once restored-top-panel restore_top_panel
once single-taskbar single_taskbar
