#!/bin/bash
# XFCE desktop session on the shared display.
# The X server, at its starting size (start-xvfb).
for _ in $(seq 100); do
    [ -e "$XDG_RUNTIME_DIR/xvfb-ready" ] && break
    sleep 0.1
done

# Save the session on logout (XFCE's built-in default is off here), unless
# the user chose otherwise in Settings > Session and Startup.
xfconf-query -c xfce4-session -p /general/SaveOnExit >/dev/null 2>&1 \
    || xfconf-query -c xfce4-session -p /general/SaveOnExit -n -t bool -s true

/usr/local/bin/workspace-migrate-panel

rm -f "$XDG_RUNTIME_DIR/stopping"
startxfce4 &
session=$!

# Chromium isn't started with the desktop, only when needed; but if it was
# open when the desktop stopped, bring it (and its tabs) back. Connecting to
# its CDP port starts it.
if [ -e /workspace/.config/chromium-shared/.open ]; then
    ( sleep 3; /usr/bin/curl -fs -o /dev/null --max-time 90 http://127.0.0.1:9221/json/version ) &
fi

# The container stopping sends SIGTERM. Log out of XFCE properly first: that
# saves the session (open terminals with their folders and tabs, file
# manager windows, window positions) so the next start restores it.
save_and_quit() {
    # Tell start-chromium that Chromium closing now isn't a person closing it.
    touch "$XDG_RUNTIME_DIR/stopping"
    xfce4-session-logout --logout 2>/dev/null || kill "$session"
    wait "$session"
    exit 0
}
trap save_and_quit TERM INT
wait "$session"
