#!/bin/bash
# Handles one connection to the shared browser's CDP port (127.0.0.1:9221,
# which the supervisor also reaches through Caddy's /_cdp/): starts Chromium
# if it isn't running (not started yet, or the human closed it), then relays
# the connection to Chromium's own port.
PORT=9220
LOCK="$XDG_RUNTIME_DIR/chromium-launch.lock"

up() { /usr/bin/curl -fs -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/json/version"; }

if ! up; then
    exec 9>"$LOCK"
    /usr/bin/flock 9  # parallel requests: only the first one starts a browser
    if ! up; then
        /usr/bin/setsid -f /usr/local/bin/start-chromium \
            </dev/null >>"$XDG_RUNTIME_DIR/chromium.log" 2>&1 9>&-
        for _ in $(seq 120); do
            up && break
            sleep 0.5
        done
    fi
    exec 9>&-
fi

exec /usr/bin/socat STDIO "TCP:127.0.0.1:$PORT"
