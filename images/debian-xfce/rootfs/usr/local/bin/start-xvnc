#!/bin/bash
# X server + VNC server + web client (KasmVNC) for the shared display :1.
# Starts at WORKSPACE_RESOLUTION; the web client resizes it to fit its window.
# Web client and its WebSocket on 127.0.0.1:6080, behind Caddy and the
# supervisor's token. -publicIP stops it from looking up the host's public IP
# on the internet (for its UDP mode, unused here).
exec Xkasmvnc :1 \
    -geometry "${WORKSPACE_RESOLUTION:-1280x800}" \
    -depth 24 \
    -AlwaysShared \
    -interface 127.0.0.1 \
    -websocketPort 6080 \
    -DisableBasicAuth \
    -sslOnly 0 \
    -httpd /usr/share/kasmvnc/www \
    -SecurityTypes None \
    -publicIP 127.0.0.1
