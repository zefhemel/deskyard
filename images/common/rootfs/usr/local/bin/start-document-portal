#!/bin/bash
set -euo pipefail
# Supervised rather than D-Bus activated, so only this process retains the
# namespace mount capability, including with no-new-privileges enabled.
for _ in $(seq 100); do
    if /usr/bin/dbus-send --session --print-reply --dest=org.freedesktop.DBus \
        /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
        exec /usr/libexec/xdg-document-portal
    fi
    sleep 0.1
done
echo 'document portal: session bus did not become ready' >&2
exit 1
