#!/bin/bash
# The X server for the shared display :1: Xvfb with a 3840x2160 framebuffer,
# so RandR can resize the screen up to that (Selkies follows the viewer's
# window). Starts at WORKSPACE_RESOLUTION, and says when it's there, so the session
# and Selkies start at that size. -noreset: without it, the server resets
# whenever its last client leaves, dropping the modes made here.
set -e
ready=$XDG_RUNTIME_DIR/xvfb-ready
rm -f "$ready"
Xvfb :1 -screen 0 3840x2160x24 -dpi 96 -nolisten tcp -noreset -ac -shmem \
    +extension COMPOSITE +extension DAMAGE +extension RANDR +extension RENDER \
    +extension MIT-SHM +extension XFIXES +extension XTEST &
xvfb=$!
trap 'kill $xvfb' TERM INT
for _ in $(seq 100); do
    xdpyinfo -display :1 >/dev/null 2>&1 && break
    sleep 0.1
done
res=${WORKSPACE_RESOLUTION:-1280x800}
w=${res%x*} h=${res#*x}
# cvt quotes the mode's name; xrandr would keep the quotes as part of it.
mode=$(cvt "$w" "$h" | sed -n 's/^Modeline //p' | tr -d '"')
name=${mode%% *}
xrandr --newmode $mode 2>/dev/null || true
xrandr --addmode screen "$name" 2>/dev/null || true
xrandr --output screen --mode "$name" || true
touch "$ready"
wait $xvfb
