#!/usr/bin/python3
"""Experimental application/window bridge. Runs as the desktop user, never root."""
import json
import os
import sys
import time
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Wnck", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gio, Gtk, Wnck, Gdk, GdkX11


def screen():
    Gtk.init([])
    Wnck.set_client_type(Wnck.ClientType.PAGER)
    s = Wnck.Screen.get_default()
    if s is None:
        raise ValueError("Desktop display is unavailable")
    s.force_update()
    return s


def windows(s):
    result = []
    for w in s.get_windows():
        if w.get_window_type() not in (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG, Wnck.WindowType.UTILITY):
            continue
        x, y, width, height = w.get_geometry()
        parent = w.get_transient()
        result.append(dict(id=str(w.get_xid()), title=w.get_name()[:512],
                           app=(w.get_class_group_name() or "Application")[:256],
                           parent=str(parent.get_xid()) if parent else None,
                           active=w.is_active(), minimized=w.is_minimized(),
                           x=x, y=y, width=width, height=height))
    return result[:256]


def inventory(s, include_apps):
    result = dict(windows=windows(s), apps=[])
    if include_apps:
        apps = [a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id()]
        result["apps"] = [dict(id=a.get_id(), name=a.get_display_name()[:256])
                          for a in sorted(apps, key=lambda a: a.get_display_name().casefold())[:1024]]
    return result


def main():
    action = sys.argv[1]
    s = screen()
    if action in ("list", "windows"):
        return inventory(s, action == "list")
    if action == "activate":
        xid = int(sys.argv[2])
        w = next((w for w in s.get_windows() if w.get_xid() == xid), None)
        if w is None:
            raise ValueError("That window has closed")
        # Server time is required by XFCE's focus-stealing prevention.
        timestamp = GdkX11.x11_get_server_time(Gdk.get_default_root_window())
        workspace = w.get_workspace()
        if workspace:
            workspace.activate(timestamp)
        w.unminimize(timestamp)
        w.activate(timestamp)
        Gdk.flush()
        return dict(id=str(xid))
    if action == "launch":
        app_id = sys.argv[2]
        app = next((a for a in Gio.AppInfo.get_all() if a.get_id() == app_id and a.should_show()), None)
        if app is None:
            raise ValueError("Application is no longer installed")
        before = {w.get_xid() for w in s.get_windows()}
        launch_context = Gdk.Display.get_default().get_app_launch_context()
        launch_context.set_timestamp(GdkX11.x11_get_server_time(Gdk.get_default_root_window()))
        launched_pids = set()
        def launched(_context, _app, data):
            pid = data.lookup_value("pid", None)
            if pid:
                launched_pids.add(pid.unpack())
        launch_context.connect("launched", launched)
        startup_class = app.get_startup_wm_class() if hasattr(app, "get_startup_wm_class") else None
        classes = {app_id[:-8].casefold()}
        if startup_class:
            classes.add(startup_class.casefold())
        def belongs(w):
            return (w.get_pid() in launched_pids or
                    (w.get_class_group_name() or "").casefold() in classes or
                    (w.get_class_instance_name() or "").casefold() in classes)
        # GUI children must not retain the exec connection's stdout/stderr.
        saved = [os.dup(1), os.dup(2)]
        try:
            with open(os.devnull, "wb") as sink:
                os.dup2(sink.fileno(), 1)
                os.dup2(sink.fileno(), 2)
                app.launch([], launch_context)
        finally:
            for fd, original in zip((1, 2), saved):
                os.dup2(original, fd)
                os.close(original)
        # Both a newly created window and activation of an existing instance
        # count. Keep this bounded: launchers can legitimately create no window.
        for _ in range(60):
            while Gtk.events_pending():
                Gtk.main_iteration_do(False)
            s.force_update()
            candidates = [w for w in s.get_windows() if w.get_xid() not in before and
                          w.get_window_type() == Wnck.WindowType.NORMAL and belongs(w)]
            if candidates:
                return dict(id=str(candidates[-1].get_xid()))
            time.sleep(0.1)
        active = s.get_active_window()
        # Match an existing single-instance app using its desktop-entry class.
        if active and belongs(active):
            return dict(id=str(active.get_xid()))
        return dict(id=None)
    raise ValueError("Unknown application action")


try:
    print(json.dumps(main(), ensure_ascii=True))
except Exception as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)
